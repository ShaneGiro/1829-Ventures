# 1829 Ventures CRM — environment configuration.
# Copy to .env and fill in secrets. Never commit .env (see .gitignore).

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# The app derives the asyncpg (API) and psycopg2 (worker/Alembic) URLs from this.
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
DB_ECHO=false
# Compose-only convenience vars (used by docker-compose.yml):
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_PORT=5432

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ALLOWED_EMAIL_DOMAINS=g.rit.edu,rit.edu
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Long-lived scoped key for Ritchie (the agent role).
AGENT_API_KEY=
# kernelbot scheduler endpoint for outbound Ritchie event fanout.
# If the backend runs in Docker and kernelbot publishes 3003, use host.docker.internal.
# If the backend runs directly on your host, http://localhost:3003/schedule also works.
RITCHIE_WEBHOOK_URL=http://host.docker.internal:3003/schedule
RITCHIE_SCHEDULER_TAG=1829-crm
RITCHIE_SCHEDULER_MODEL=sonnet
RITCHIE_SCHEDULER_MAX_RETRIES=1
# Synchronous chat API exposed by kernelbot admin on host port 3004.
RITCHIE_CHAT_URL=http://host.docker.internal:3004/invoke?wait=true
RITCHIE_CHAT_TIMEOUT_SECONDS=120
RITCHIE_CRM_API_BASE_URL=http://host.docker.internal:8000/api
RITCHIE_CRM_MCP_URL=http://host.docker.internal:8000/mcp

# ─── Object storage (MinIO in v1; Cloudflare R2 in v2 — same interface) ───────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=crm-documents
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=crm@1829.ventures
DIGEST_SEND_HOUR=9
TIMEZONE=America/New_York

# ─── Search / embeddings ─────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_ENABLED=true
EMBEDDING_BATCH_SIZE=32
# Company search: max semantic (vector) matches appended after exact matches, and
# the minimum cosine similarity to include one (higher = stricter).
SEARCH_SEMANTIC_LIMIT=25
SEARCH_SEMANTIC_THRESHOLD=0.3

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
OFFSITE_DIR=
RETENTION_DAYS=14
